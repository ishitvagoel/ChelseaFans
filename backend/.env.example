# FastAPI BFF — never expose these to the Vite app.
FOOTBALL_DATA_API_KEY=
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Neon / Postgres (postgresql+asyncpg://user:pass@host/db?ssl=require)
# SQLite for local: sqlite+aiosqlite:///./chelsea.db
DATABASE_URL=sqlite+aiosqlite:///./chelsea.db

# Upstash REST (preferred on serverless-ish hosts)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# TCP Redis (docker compose)
REDIS_URL=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

CHELSEA_FOOTBALL_DATA_TEAM_ID=61
CHELSEA_API_FOOTBALL_TEAM_ID=49

# true = exclusive sample data for the whole app (no live sports API calls).
# Set false only after FOOTBALL_DATA_API_KEY / API_FOOTBALL_KEY are configured.
USE_DEMO_DATA=true
